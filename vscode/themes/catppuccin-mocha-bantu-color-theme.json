  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment.bantu", "comment.line.double-slash.bantu", "comment.block.bantu", "punctuation.definition.comment.bantu"],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword Control",
      "scope": "keyword.control.bantu",
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword Declaration",
      "scope": "keyword.declaration.bantu",
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword IO",
      "scope": "keyword.io.bantu",
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword Modifier",
      "scope": "keyword.modifier.bantu",
      "settings": {
        "foreground": "#fab387",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword Exception",
      "scope": "keyword.exception.bantu",
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword Other (sua)",
      "scope": "keyword.other.bantu",
      "settings": {
        "foreground": "#89dceb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword Class",
      "scope": "keyword.other.class.bantu",
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Primitive Types",
