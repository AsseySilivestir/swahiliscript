        "foreground": "#f9e2af",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language Constants",
      "scope": "constant.language.bantu",
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Sua API Methods",
