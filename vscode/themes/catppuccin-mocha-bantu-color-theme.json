      "scope": "entity.name.function.bantu",
      "settings": {
        "foreground": "#a6e3a1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String Double Quoted",
      "scope": "string.quoted.double.bantu",
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "String Single Quoted",
      "scope": "string.quoted.single.bantu",
      "settings": {
        "foreground": "#a6e3a1"
      }
